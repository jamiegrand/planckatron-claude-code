{
  "version": "2.3.0",
  "description": "Universal project type configurations for Planckatron with structured detection",

  "projectTypes": {
    "frontend": {
      "name": "Frontend UI",
      "description": "React, Next.js, Vue, Svelte - UI components and pages",
      "detectPatterns": {
        "files": ["package.json", "next.config.*", "vite.config.*", "nuxt.config.*"],
        "contentMatch": {
          "package.json": ["\"react\"", "\"next\"", "\"vue\"", "\"svelte\"", "\"@angular/core\""]
        },
        "directories": ["src/app", "src/components", "src/pages", "pages", "app"]
      },
      "zones": {
        "alpha": {
          "name": "Foundation",
          "responsibility": "Layout, styling, theme, configuration",
          "owns": [
            "src/app/layout.tsx",
            "src/app/globals.css",
            "src/styles/**",
            "styles/**",
            "tailwind.config.*",
            "postcss.config.*",
            "next.config.*",
            "vite.config.*"
          ],
          "forbidden": [
            "src/components/**",
            "src/app/page.tsx",
            "src/app/**/page.tsx",
            "src/data/**",
            "src/hooks/**"
          ]
        },
        "beta": {
          "name": "Components",
          "responsibility": "UI components, data, hooks, utilities",
          "owns": [
            "src/components/**",
            "src/data/**",
            "src/hooks/**",
            "src/lib/**",
            "src/types/**",
            "src/utils/**"
          ],
          "forbidden": [
            "src/app/layout.tsx",
            "src/app/globals.css",
            "src/app/page.tsx",
            "src/app/**/page.tsx",
            "src/styles/**"
          ]
        },
        "gamma": {
          "name": "Integration",
          "responsibility": "Page composition, assembly, final integration",
          "owns": [
            "src/app/page.tsx",
            "src/app/**/page.tsx",
            "pages/**/*.tsx",
            "app/**/page.tsx"
          ],
          "forbidden": [
            "src/app/layout.tsx",
            "src/app/globals.css",
            "src/components/**",
            "src/lib/**",
            "src/hooks/**"
          ]
        }
      }
    },

    "backend": {
      "name": "Backend API",
      "description": "Node.js, Express, Fastify, NestJS - Server-side APIs",
      "detectPatterns": {
        "files": ["package.json", "tsconfig.json"],
        "contentMatch": {
          "package.json": ["\"express\"", "\"fastify\"", "\"@nestjs/core\"", "\"koa\"", "\"hapi\""]
        },
        "directories": ["src/routes", "src/controllers", "src/models", "src/services"]
      },
      "zones": {
        "alpha": {
          "name": "Models & Schema",
          "responsibility": "Database models, schemas, types, validation",
          "owns": [
            "src/models/**",
            "src/schemas/**",
            "src/types/**",
            "src/entities/**",
            "prisma/**",
            "drizzle/**"
          ],
          "forbidden": [
            "src/routes/**",
            "src/controllers/**",
            "src/services/**",
            "src/app.ts",
            "src/index.ts"
          ]
        },
        "beta": {
          "name": "Services & Logic",
          "responsibility": "Business logic, services, utilities",
          "owns": [
            "src/services/**",
            "src/utils/**",
            "src/helpers/**",
            "src/middleware/**",
            "src/validators/**"
          ],
          "forbidden": [
            "src/models/**",
            "src/routes/**",
            "src/controllers/**",
            "src/app.ts",
            "src/index.ts"
          ]
        },
        "gamma": {
          "name": "Routes & Controllers",
          "responsibility": "API endpoints, controllers, route assembly",
          "owns": [
            "src/routes/**",
            "src/controllers/**",
            "src/app.ts",
            "src/index.ts",
            "src/server.ts"
          ],
          "forbidden": [
            "src/models/**",
            "src/services/**",
            "src/middleware/**"
          ]
        }
      }
    },

    "fullstack": {
      "name": "Full-Stack Application",
      "description": "Combined frontend and backend in one project",
      "detectPatterns": {
        "files": ["package.json", "next.config.*"],
        "contentMatch": {
          "package.json": ["\"next\"", "\"@trpc/server\"", "\"prisma\""]
        },
        "directories": ["src/app", "app/api", "src/server", "src/api"]
      },
      "zones": {
        "alpha": {
          "name": "Backend & API",
          "responsibility": "API routes, server actions, database",
          "owns": [
            "src/api/**",
            "src/server/**",
            "src/db/**",
            "src/actions/**",
            "app/api/**",
            "prisma/**",
            "drizzle/**"
          ],
          "forbidden": [
            "src/components/**",
            "src/app/page.tsx",
            "src/app/**/page.tsx",
            "app/page.tsx",
            "src/hooks/**"
          ]
        },
        "beta": {
          "name": "Frontend Components",
          "responsibility": "UI components, hooks, client utilities",
          "owns": [
            "src/components/**",
            "components/**",
            "src/hooks/**",
            "src/lib/client/**",
            "src/utils/client/**"
          ],
          "forbidden": [
            "src/api/**",
            "app/api/**",
            "src/server/**",
            "src/app/page.tsx",
            "src/app/layout.tsx"
          ]
        },
        "gamma": {
          "name": "Pages & Integration",
          "responsibility": "Page composition, layouts, integration",
          "owns": [
            "src/app/page.tsx",
            "src/app/**/page.tsx",
            "src/app/layout.tsx",
            "app/page.tsx",
            "app/**/page.tsx",
            "app/layout.tsx"
          ],
          "forbidden": [
            "src/api/**",
            "app/api/**",
            "src/components/**",
            "src/server/**"
          ]
        }
      }
    },

    "automation": {
      "name": "Automation & Scripts",
      "description": "CLI tools, scripts, pipelines, automation workflows",
      "detectPatterns": {
        "files": ["package.json"],
        "contentMatch": {
          "package.json": ["\"commander\"", "\"yargs\"", "\"inquirer\"", "\"ora\"", "\"chalk\""]
        },
        "directories": ["scripts", "src/cli", "src/commands", "bin"]
      },
      "zones": {
        "alpha": {
          "name": "Core Scripts",
          "responsibility": "Main automation scripts, core logic",
          "owns": [
            "scripts/**",
            "src/core/**",
            "src/commands/**"
          ],
          "forbidden": [
            "src/config/**",
            "src/cli.ts",
            "src/index.ts",
            "bin/**"
          ]
        },
        "beta": {
          "name": "Utilities & Config",
          "responsibility": "Helper utilities, configuration, templates",
          "owns": [
            "src/utils/**",
            "src/config/**",
            "src/templates/**",
            "config/**"
          ],
          "forbidden": [
            "scripts/**",
            "src/cli.ts",
            "src/commands/**",
            "bin/**"
          ]
        },
        "gamma": {
          "name": "CLI & Entry",
          "responsibility": "CLI interface, entry points, pipeline assembly",
          "owns": [
            "src/cli.ts",
            "src/index.ts",
            "src/main.ts",
            "bin/**",
            "src/pipeline/**"
          ],
          "forbidden": [
            "scripts/**",
            "src/utils/**",
            "src/config/**"
          ]
        }
      }
    },

    "agentic": {
      "name": "Agentic Workflows",
      "description": "AI agents, LLM workflows, autonomous systems",
      "detectPatterns": {
        "files": ["package.json"],
        "contentMatch": {
          "package.json": ["\"@anthropic-ai/sdk\"", "\"openai\"", "\"langchain\"", "\"@ai-sdk\""]
        },
        "directories": ["src/agents", "src/prompts", "src/tools"]
      },
      "zones": {
        "alpha": {
          "name": "Agents & Core",
          "responsibility": "Agent definitions, core agent logic",
          "owns": [
            "src/agents/**",
            "src/core/**",
            "src/memory/**"
          ],
          "forbidden": [
            "src/tools/**",
            "src/orchestrator/**",
            "src/prompts/**",
            "src/index.ts"
          ]
        },
        "beta": {
          "name": "Tools & Prompts",
          "responsibility": "Agent tools, prompts, utilities",
          "owns": [
            "src/tools/**",
            "src/prompts/**",
            "src/utils/**",
            "src/parsers/**"
          ],
          "forbidden": [
            "src/agents/**",
            "src/orchestrator/**",
            "src/core/**",
            "src/index.ts"
          ]
        },
        "gamma": {
          "name": "Orchestration",
          "responsibility": "Agent orchestration, workflows, entry points",
          "owns": [
            "src/orchestrator/**",
            "src/workflows/**",
            "src/index.ts",
            "src/main.ts"
          ],
          "forbidden": [
            "src/agents/**",
            "src/tools/**",
            "src/prompts/**"
          ]
        }
      }
    },

    "python": {
      "name": "Python Backend",
      "description": "FastAPI, Django, Flask - Python server-side applications",
      "detectPatterns": {
        "files": ["requirements.txt", "pyproject.toml", "setup.py", "Pipfile"],
        "contentMatch": {
          "requirements.txt": ["fastapi", "django", "flask", "uvicorn"],
          "pyproject.toml": ["fastapi", "django", "flask"]
        },
        "directories": ["app", "src", "api", "models", "routers"]
      },
      "zones": {
        "alpha": {
          "name": "Models & Schema",
          "responsibility": "Database models, Pydantic schemas, types",
          "owns": [
            "models/**",
            "app/models/**",
            "schemas/**",
            "app/schemas/**",
            "db/**"
          ],
          "forbidden": [
            "routers/**",
            "api/**",
            "services/**",
            "main.py",
            "app.py"
          ]
        },
        "beta": {
          "name": "Services & Logic",
          "responsibility": "Business logic, services, utilities",
          "owns": [
            "services/**",
            "app/services/**",
            "utils/**",
            "app/utils/**",
            "core/**"
          ],
          "forbidden": [
            "models/**",
            "routers/**",
            "api/**",
            "main.py"
          ]
        },
        "gamma": {
          "name": "Routes & Entry",
          "responsibility": "API endpoints, routers, entry points",
          "owns": [
            "routers/**",
            "app/routers/**",
            "api/**",
            "app/api/**",
            "main.py",
            "app.py"
          ],
          "forbidden": [
            "models/**",
            "services/**",
            "schemas/**"
          ]
        }
      }
    },

    "go": {
      "name": "Go Backend",
      "description": "Gin, Echo, Fiber - Go server-side applications",
      "detectPatterns": {
        "files": ["go.mod", "go.sum"],
        "contentMatch": {
          "go.mod": ["gin-gonic", "echo", "fiber", "chi"]
        },
        "directories": ["cmd", "internal", "pkg", "handlers", "models"]
      },
      "zones": {
        "alpha": {
          "name": "Models & Domain",
          "responsibility": "Domain models, database, types",
          "owns": [
            "internal/models/**",
            "internal/domain/**",
            "pkg/models/**",
            "internal/repository/**"
          ],
          "forbidden": [
            "internal/handlers/**",
            "internal/services/**",
            "cmd/**"
          ]
        },
        "beta": {
          "name": "Services & Logic",
          "responsibility": "Business logic, services",
          "owns": [
            "internal/services/**",
            "internal/usecase/**",
            "pkg/utils/**",
            "internal/middleware/**"
          ],
          "forbidden": [
            "internal/models/**",
            "internal/handlers/**",
            "cmd/**"
          ]
        },
        "gamma": {
          "name": "Handlers & Entry",
          "responsibility": "HTTP handlers, routers, entry points",
          "owns": [
            "internal/handlers/**",
            "internal/router/**",
            "cmd/**",
            "main.go"
          ],
          "forbidden": [
            "internal/models/**",
            "internal/services/**",
            "internal/repository/**"
          ]
        }
      }
    },

    "library": {
      "name": "Library / Package",
      "description": "Reusable library, npm package, SDK",
      "detectPatterns": {
        "files": ["package.json", "tsconfig.json"],
        "contentMatch": {
          "package.json": ["\"main\"", "\"module\"", "\"exports\""]
        },
        "directories": ["src", "lib", "dist"]
      },
      "zones": {
        "alpha": {
          "name": "Core Implementation",
          "responsibility": "Core library logic, main functionality",
          "owns": [
            "src/core/**",
            "src/lib/**",
            "lib/**"
          ],
          "forbidden": [
            "src/index.ts",
            "src/types/**",
            "src/utils/**"
          ]
        },
        "beta": {
          "name": "Types & Utilities",
          "responsibility": "Type definitions, helpers, utilities",
          "owns": [
            "src/types/**",
            "src/utils/**",
            "src/helpers/**"
          ],
          "forbidden": [
            "src/core/**",
            "src/index.ts",
            "lib/**"
          ]
        },
        "gamma": {
          "name": "Exports & API",
          "responsibility": "Public API, exports, documentation",
          "owns": [
            "src/index.ts",
            "src/exports/**",
            "index.ts"
          ],
          "forbidden": [
            "src/core/**",
            "src/utils/**",
            "lib/**"
          ]
        }
      }
    },

    "monorepo": {
      "name": "Monorepo",
      "description": "Multi-package repository with shared code",
      "detectPatterns": {
        "files": ["pnpm-workspace.yaml", "lerna.json", "nx.json", "turbo.json"],
        "contentMatch": {},
        "directories": ["packages", "apps", "libs"]
      },
      "zones": {
        "alpha": {
          "name": "Shared Packages",
          "responsibility": "Shared libraries, common utilities",
          "owns": [
            "packages/shared/**",
            "packages/common/**",
            "packages/utils/**",
            "libs/shared/**"
          ],
          "forbidden": [
            "apps/**",
            "packages/ui/**",
            "packages/web/**"
          ]
        },
        "beta": {
          "name": "UI & Components",
          "responsibility": "UI package, component library",
          "owns": [
            "packages/ui/**",
            "packages/components/**",
            "libs/ui/**"
          ],
          "forbidden": [
            "packages/shared/**",
            "apps/**",
            "libs/shared/**"
          ]
        },
        "gamma": {
          "name": "Applications",
          "responsibility": "Application packages, integration",
          "owns": [
            "apps/**"
          ],
          "forbidden": [
            "packages/**",
            "libs/**"
          ]
        }
      }
    },

    "custom": {
      "name": "Custom Configuration",
      "description": "User-defined zone configuration",
      "detectPatterns": {
        "files": [],
        "contentMatch": {},
        "directories": []
      },
      "zones": {
        "alpha": {
          "name": "Track A",
          "responsibility": "User-defined",
          "owns": [],
          "forbidden": []
        },
        "beta": {
          "name": "Track B",
          "responsibility": "User-defined",
          "owns": [],
          "forbidden": []
        },
        "gamma": {
          "name": "Track C",
          "responsibility": "User-defined",
          "owns": [],
          "forbidden": []
        }
      }
    }
  },

  "defaultType": "frontend",

  "detectionPriority": [
    "monorepo",
    "agentic",
    "fullstack",
    "python",
    "go",
    "backend",
    "frontend",
    "automation",
    "library"
  ]
}
